# Public Firebase web config. These are identifiers, not administrator credentials.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
# Server only. Never prefix secrets with PUBLIC/VITE or place them in public/.
FIREBASE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ORDER_TOKEN_SECRET=
SITE_URL=https://your-site.netlify.app
# Leave disabled until shipping, prices, stock and Stripe webhooks are verified.
CHECKOUT_ENABLED=false
# Default prototype mode. Switch to live only after configuring Firebase and rules.
APP_MODE=demo

# Shop mail: server-only key; verify sender domain in Resend first.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Bienvica <orders@notify.bienvica.com>
# Shop recipient: thanakrittum@gmail.com, configured server-side.

# Server functions only — never expose these through client config
ERP_INTEGRATION_ENABLED=false
ERP_BRIDGE_URL=https://bev-pro-erp.netlify.app/.netlify/functions/commerce
ERP_BRIDGE_SECRET=
