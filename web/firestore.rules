rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /content/{id} { allow read: if id == 'published' || admin(); allow write: if false; }
    match /products/{id} { allow read: if resource.data.active == true || admin(); allow write: if false; }
    match /posts/{id} { allow read: if resource.data.status == 'published' || admin(); allow write: if false; }
    match /comments/{id} { allow read: if resource.data.status == 'published' || admin(); allow write: if false; }
    match /polls/{id} { allow read: if resource.data.active == true || admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
