rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /public/{path=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /submissions/{uid}/{file} {
      allow read: if admin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /{path=**} { allow read, write: if false; }
  }
}
